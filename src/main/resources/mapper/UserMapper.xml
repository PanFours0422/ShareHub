<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sharehub.mapper.UserMapper">
    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, username, password, email, phone, create_time, update_time, status
    </sql>

    <!-- 插入用户 -->
    <insert id="insert" parameterType="com.sharehub.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, email, phone, status)
        VALUES (#{username}, #{password}, #{email}, #{phone}, #{status})
    </insert>

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultType="com.sharehub.entity.User">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE username = #{username}
        AND status = 1
    </select>

    <!-- 根据邮箱查询用户 -->
    <select id="selectByEmail" resultType="com.sharehub.entity.User">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE email = #{email}
        AND status = 1
    </select>

    <!-- 根据电话查询用户 -->
    <select id="selectByPhone" resultType="com.sharehub.entity.User">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE phone = #{phone}
        AND status = 1
    </select>

    <!-- 获取所有用户 -->
    <select id="selectAll" resultType="com.sharehub.entity.User">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE status = 1
    </select>

    <!-- 根据ID查询用户 -->
    <select id="selectById" resultType="com.sharehub.entity.User">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE id = #{id}
        AND status = 1
    </select>

    <!-- 更新用户信息 -->
    <update id="update" parameterType="com.sharehub.entity.User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <update id="delete">
        UPDATE user
        SET status = 0
        WHERE id = #{id}
    </update>
</mapper> 